{
  "name": "demo-film-kit",
  "private": true,
  "type": "module",
  "scripts": {
    "build:film": "node scripts/build.mjs",
    "pages": "vite build",
    "plan": "python3 capture/plan.py film",
    "stills": "python3 capture/plan.py stills",
    "engine": "capture/film.sh plan-film.json master",
    "studio": "node scripts/render.mjs studio/ studio --gpu",
    "ui": "node scripts/render.mjs ui/ ui",
    "captions": "node scripts/overlay.mjs out/captions.mov",
    "cut": "node scripts/cut.mjs out/captions.mov out/body-picture.mp4",
    "mix": "node scripts/mix.mjs out/body-picture.mp4 out/body.mp4"
  },
  "dependencies": {
    "playwright-core": "^1.63.0",
    "three": "0.172.0",
    "vite": "^8.3.2"
  }
}
